{
  "config": {
    "MD004": { "style": "dash" },
    "MD010": { "code_blocks": false },
    "MD013": {
      "line_length": 80,
      "code_block_line_length": 120,
      "tables": false,
      "headings": false
    },
    "MD029": { "style": "ordered" }
  },
  "ignores": [
    // The repository has remote branches whose names end in `.md`; the
    // action must not read their reflogs as documents.
    ".git/**",
    "**/.venv/**",
    ".node_modules/**",
    "**/node_modules/**",
    "**/target/**",
    ".terraform/**",
    ".uv-cache/**",
    "CRUSH.md",
    ".vtcode/**",
    "memories/**"
  ]
}
