# serializer version: 1
# name: test_no_qa_run_characterization[generator_cancelled]
  dict({
    'episode': dict({
      'has_generated_draft': False,
      'qa_status': None,
      'tei_content_hash': '<sha256>',
      'tei_revision': 1,
    }),
    'events': list([
      dict({
        'kind': 'run.started',
        'payload': dict({
          'current_node': 'draft',
        }),
      }),
      dict({
        'kind': 'run.failed',
        'payload': dict({
          'error_category': 'launcher.shutdown',
          'error_message': 'Generation task cancelled during shutdown.',
        }),
      }),
    ]),
    'metrics': list([
      dict({
        'kind': 'value',
        'labels': dict({
        }),
        'name': 'generation_run_pending_depth',
        'value': 0.0,
      }),
      dict({
        'kind': 'latency_ms',
        'labels': dict({
          'quality_mode': 'draft_without_qa',
        }),
        'name': 'generation_run_draft_latency_ms',
        'value': '<elapsed_ms>',
      }),
      dict({
        'kind': 'counter',
        'labels': dict({
          'error_category': 'launcher.shutdown',
          'status': 'failed',
        }),
        'name': 'generation_run_terminal_total',
        'value': 1.0,
      }),
      dict({
        'kind': 'counter',
        'labels': dict({
          'error_category': 'launcher.shutdown',
        }),
        'name': 'generation_run_draft_errors_total',
        'value': 1.0,
      }),
      dict({
        'kind': 'counter',
        'labels': dict({
          'quality_mode': 'draft_without_qa',
        }),
        'name': 'generation_run_qa_bypass_total',
        'value': 1.0,
      }),
      dict({
        'kind': 'value',
        'labels': dict({
        }),
        'name': 'generation_run_pending_depth',
        'value': 0.0,
      }),
    ]),
    'run': dict({
      'current_node': None,
      'error_category': 'launcher.shutdown',
      'error_message': 'Generation task cancelled during shutdown.',
      'has_ended_at': True,
      'has_started_at': True,
      'qa_status': 'skipped',
      'quality_mode': 'draft_without_qa',
      'skip_qa_rationale': 'Vertical slice draft.',
      'status': 'failed',
    }),
    'spans': list([
      dict({
        'attributes': dict({
          'failure_category': 'launcher.shutdown',
          'operation': 'generation_run.execute',
          'outcome': 'cancelled',
          'run_id': '<uuid>',
        }),
        'is_completed': True,
        'name': 'generation_run.execute',
      }),
    ]),
  })
