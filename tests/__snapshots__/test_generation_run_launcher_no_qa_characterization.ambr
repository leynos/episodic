# name: test_no_qa_run_characterization[success]
  dict({
    'episode': dict({
      'has_generated_draft': True,
      'qa_status': 'skipped',
      'tei_content_hash': '<sha256>',
      'tei_revision': 2,
    }),
    'events': list([
      dict({
        'kind': 'run.started',
        'payload': dict({
          'current_node': 'draft',
        }),
      }),
      dict({
        'kind': 'draft.generated',
        'payload': dict({
          'content_hash': '<sha256>',
          'finish_reason': 'stop',
          'model': 'gpt-4o-mini',
          'provider_response_id': 'resp-draft-1',
          'usage': dict({
            'input_tokens': 10,
            'output_tokens': 20,
            'total_tokens': 30,
          }),
        }),
      }),
      dict({
        'kind': 'tei.persisted',
        'payload': dict({
          'content_hash': '<sha256>',
          'qa_status': 'skipped',
          'tei_revision': 2,
        }),
      }),
      dict({
        'kind': 'run.succeeded',
        'payload': dict({
          'current_node': 'complete',
        }),
      }),
    ]),
    'metrics': list([
      dict({
        'kind': 'value',
        'labels': dict({
        }),
        'name': 'generation_run_pending_depth',
        'value': 0.0,
      }),
      dict({
        'kind': 'latency_ms',
        'labels': dict({
          'quality_mode': 'draft_without_qa',
        }),
        'name': 'generation_run_draft_latency_ms',
        'value': '<elapsed_ms>',
      }),
      dict({
        'kind': 'counter',
        'labels': dict({
          'error_category': 'none',
          'status': 'succeeded',
        }),
        'name': 'generation_run_terminal_total',
        'value': 1.0,
      }),
      dict({
        'kind': 'counter',
        'labels': dict({
          'quality_mode': 'draft_without_qa',
        }),
        'name': 'generation_run_qa_bypass_total',
        'value': 1.0,
      }),
      dict({
        'kind': 'value',
        'labels': dict({
        }),
        'name': 'generation_run_pending_depth',
        'value': 0.0,
      }),
    ]),
    'run': dict({
      'current_node': None,
      'error_category': None,
      'error_message': None,
      'has_ended_at': True,
      'has_started_at': True,
      'qa_status': 'skipped',
      'quality_mode': 'draft_without_qa',
      'skip_qa_rationale': 'Vertical slice draft.',
      'status': 'succeeded',
    }),
    'spans': list([
      dict({
        'attributes': dict({
          'operation': 'generation_run.execute',
          'outcome': 'completed',
          'quality_branch': 'draft_without_qa',
          'run_id': '<uuid>',
          'terminal': 'draft_persisted_without_qa',
        }),
        'is_completed': True,
        'name': 'generation_run.execute',
      }),
    ]),
  })
